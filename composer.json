{
  "name": "violika7-cell/wordpress-api-integration-example",
  "description": "Synthetic showcase of a maintainable WordPress REST API integration.",
  "type": "wordpress-plugin",
  "license": "MIT",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Showcase\\ApiIntegration\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Showcase\\ApiIntegration\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
